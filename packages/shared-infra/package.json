{
  "name": "@promptalicious/shared-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Shared infrastructure and configuration for promptalicious monorepo",
  "type": "module",
  "exports": {
    "./tsconfig": "./tsconfig.json",
    "./eslint": "./src/eslint/createEslintConfig.js",
    "./eslint/base": "./src/eslint/base.config.js",
    "./eslint/frontend": "./src/eslint/frontend.config.js"
  },
  "files": [
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
