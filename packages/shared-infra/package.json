{
  "name": "@promptalicious/shared-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Shared infrastructure and configuration for promptalicious monorepo",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tsconfig": "./tsconfig.json",
    "./eslint": "./src/eslint/createEslintConfig.ts",
    "./eslint/base": "./src/eslint/base.config.ts",
    "./eslint/frontend": "./src/eslint/frontend.config.ts"
  },
  "files": [
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
