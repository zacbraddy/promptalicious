{
  "extends": "../shared-infra/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "eslint.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "dist", "tests/fixtures"]
}
